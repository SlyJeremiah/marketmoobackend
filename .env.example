# Copy to .env (never commit real values) or set these in the Render dashboard.
MARKETMOO_SECRET_KEY=change-me-to-a-long-random-string
MARKETMOO_DEBUG=0
MARKETMOO_ALLOWED_HOSTS=your-service.onrender.com
# Neon PostgreSQL connection string. Leave empty to use local SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require
# Backblaze B2 (S3-compatible API). Create an application key limited to the bucket.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=marketmoo
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# Origins of the manager dashboard (comma separated)
MARKETMOO_CORS_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app
# Dotted path to an SMS backend class with send(phone, text). The console backend only logs (development).
MARKETMOO_SMS_BACKEND=accounts.sms.ConsoleSmsBackend
